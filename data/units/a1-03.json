 "speak": [
  {
   "de": "Was machst du?",
   "es": "¿Qué haces?",
   "tip": "«ch» después de a, o, u suena como una j española suave: «majst»."
  },
  {
   "de": "Ich arbeite in Heidelberg.",
   "es": "Trabajo en Heidelberg.",
   "tip": "«ei» = «ai»: «arbaite». La «h» de Heidelberg es aspirada, muy suave."
  },
  {
   "de": "Hast du heute Zeit?",
   "es": "¿Tienes tiempo hoy?",
   "tip": "«eu» = «oi»: «hoite». «z» = «ts»: «tsait»."
  },
  {
   "de": "Ich bin Biologin.",
   "es": "Soy bióloga.",
   "tip": "Acento en la tercera sílaba: bi-o-LO-gin, con o larga."
  },
  {
   "de": "Was sind Sie von Beruf?",
   "es": "¿Cuál es su profesión?",
   "tip": "«v» en «von» suena como f: «fon». «s» inicial de «sind» sonora: «zint». Acento: be-RUF."
  },
  {
   "de": "Wie findest du Berlin?",
   "es": "¿Qué te parece Berlín?",
   "tip": "Acento al final: ber-LIN. La «r» alemana se hace al fondo de la garganta, no con la punta de la lengua."
  },
  {
   "de": "Ich habe Hunger.",
   "es": "Tengo hambre.",
   "tip": "La «h» se aspira: echa aire como al empañar un cristal. La -er final suena casi como una «a»: «hunga»."
  }
 ],
